 /* ---- motion ---- */
 @keyframes cardIn{from{opacity:0;transform:translateY(14px) scale(.985)}to{opacity:1;transform:none}}
-@keyframes imgIn{to{opacity:1}}
 @keyframes slideL{from{opacity:.2;transform:translateX(28px)}to{opacity:1;transform:none}}
 @keyframes slideR{from{opacity:.2;transform:translateX(-28px)}to{opacity:1;transform:none}}
 @keyframes spin{to{transform:rotate(360deg)}}
 @keyframes fadeIn{from{opacity:0}to{opacity:1}}
 @keyframes toastIn{from{opacity:0;transform:translate(-50%,8px)}to{opacity:1;transform:translate(-50%,0)}}
-@keyframes sheetUp{from{opacity:0;transform:translateY(26px) scale(.985)}to{opacity:1;transform:none}}
-@keyframes viewerIn{from{opacity:0;transform:scale(.985)}to{opacity:1;transform:none}}
 .card{animation:cardIn .38s cubic-bezier(.22,.8,.25,1) both;animation-delay:calc(var(--i,0)*24ms)}
-.card{transition:transform .22s ease,opacity .2s}
-.card:hover{transform:translateY(-2px)}
 .photo img{opacity:0;transition:opacity .35s ease}
 .photo img.loaded{opacity:1}
+/* 操作后的就地刷新：不重播入场动画，也不让图片闪一下 */
+.grid.still .card{animation:none}
+.grid.still .photo img{opacity:1;transition:none}
 .grid.slide-l{animation:slideL .34s cubic-bezier(.22,.8,.25,1)}
