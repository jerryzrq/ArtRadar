-.icon,.filterbtn,.selectall,.tabs button,.catquick button,.searchicon{transition:color .18s,background .18s,transform .12s,opacity .18s}
-.icon:active,.filterbtn:active,.selectall:active,.catquick button:active,.searchicon:active{transform:scale(.88)}
-.tabs button::after{transition:transform .22s,opacity .22s}
