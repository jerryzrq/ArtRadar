+.fopt:active,.ftag:active,.menurow:active{transform:scale(.97)}
 .sheet{display:flex;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .22s ease,visibility .22s}
 .sheet.show{opacity:1;visibility:visible;pointer-events:auto}
-.sheet .box{transform:translateY(28px) scale(.985);transition:transform .28s cubic-bezier(.22,.9,.28,1);}
